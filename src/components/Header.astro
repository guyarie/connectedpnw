---
import SocialLinks from './SocialLinks.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'Founders', href: '/about' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Events', href: '/events' },
  { label: 'Blog', href: '/blog/' },
];
---

<header>
  <div class="container nav">
    <a class="brand" href="/" aria-label="Connected PNW home">
      <img src="/images/website-logo-cropped.png" alt="Connected PNW" class="brand-logo" />
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:0.75rem;">
      <SocialLinks class="header-social" />
      <a class="btn btn-primary header-cta" href="/contact" style="min-height:40px;padding:0.6rem 1rem;font-size:var(--text-xs);">
        Join interest list
      </a>
      <button
        class="theme-toggle header-theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        data-theme-toggle
      >◐</button>
      <button
        class="nav-hamburger"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-hamburger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
    {navLinks.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
    <a href="/contact" class="btn btn-primary" style="margin-top:var(--space-2);">Join interest list</a>
    <button
      class="theme-toggle mobile-nav-theme-toggle"
      type="button"
      aria-label="Toggle color theme"
      data-theme-toggle
    >◐ Toggle theme</button>
    <SocialLinks class="mobile-nav-social" />
  </nav>
</header>

<script>
  const btn = document.querySelector('[data-hamburger]') as HTMLButtonElement;
  const menu = document.getElementById('mobile-nav') as HTMLElement;
  btn?.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.classList.toggle('is-open', open);
  });
  menu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('is-open');
    });
  });
</script>
