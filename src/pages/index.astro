---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('site', 'home');
const how  = await getEntry('site', 'how');

const h = home.data;
const phases = how.data.phases ?? [];
---

<Base title={h.title} description={h.description}>

  <Banner />

  <!-- ── Hero ── -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div>
        {h.eyebrow && <div class="eyebrow">{h.eyebrow}</div>}
        {h.hero_heading && <h1>{h.hero_heading}</h1>}
        {h.hero_lead && <p class="lead">{h.hero_lead}</p>}
        <div class="actions">
          {h.cta_primary_label && (
            <a class="btn btn-primary" href={h.cta_primary_url}>{h.cta_primary_label}</a>
          )}
          {h.cta_secondary_label && (
            <a class="btn btn-secondary" href={h.cta_secondary_url}>{h.cta_secondary_label}</a>
          )}
        </div>
        {h.hero_note && <p class="muted hero-note">{h.hero_note}</p>}
      </div>

      <ImageSlot
        src={h.hero_image}
        alt={h.hero_image_alt}
        placeholder={h.hero_image_placeholder}
        class="is-hero"
      />
    </div>
  </section>

  <!-- ── Different starting points ── -->
  {h.audiences && h.audiences.length > 0 && (
    <section id="who">
      <div class="container">
        {h.audience_heading && (
          <div class="page-intro is-wide"><h2>{h.audience_heading}</h2></div>
        )}
        <div class="audience-grid">
          {h.audiences.map((a) => (
            <article class="audience-item">
              <ImageSlot src={a.image} alt={a.image_alt} placeholder={a.label} />
              <p>{a.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── What makes Connected different ── -->
  {h.features && h.features.length > 0 && (
    <section id="difference">
      <div class="container">
        <div class="page-intro">
          {h.features_heading && <h2>{h.features_heading}</h2>}
          {h.features_intro && <p>{h.features_intro}</p>}
        </div>
        <div class="feature-grid">
          {h.features.map((f) => (
            <article class="feature">
              <h3>{f.heading}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── The Connected Experience ── -->
  {phases.length > 0 && (
    <section id="experience">
      <div class="container">
        <div class="page-intro">
          {h.phases_heading && <h2>{h.phases_heading}</h2>}
          {h.phases_intro && <p>{h.phases_intro}</p>}
        </div>
        <div class="story-flow">
          {phases.map((p) => (
            <article class="story">
              <div class="story-copy">
                <p class="step-num">{p.num}</p>
                <h3>{p.heading}</h3>
                <p>{p.body}</p>
              </div>
              <div class="story-media">
                <ImageSlot src={p.image} alt={p.image_alt} placeholder={p.image_placeholder} />
              </div>
            </article>
          ))}
        </div>
        {h.actions && (
          <div class="actions">
            {h.actions.map((a) => (
              <a class={`btn btn-${a.style ?? 'secondary'}`} href={a.url}>{a.label}</a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── Closing CTA ── -->
  {h.cta_heading && (
    <section id="join">
      <div class="container">
        <div class="cta-band">
          <h2>{h.cta_heading}</h2>
          {h.cta_body && <p>{h.cta_body}</p>}
          {h.cta_label && (
            <div class="actions">
              <a class="btn btn-primary" href={h.cta_url}>{h.cta_label}</a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

</Base>
