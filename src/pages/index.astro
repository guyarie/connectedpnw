---
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('site', 'home');
const how  = await getEntry('site', 'how');

const events = await getEntry('site', 'events');
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' });
const upcoming = [...(events.data.events ?? [])]
  .filter((ev) => ev.date >= today && ev.id && ev.summary)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 3);
const h = home.data;
const phases = how.data.phases ?? [];
---

<Base title={h.title} description={h.description}>

  <Banner />

  <!-- ── Hero ── -->
  <section class="hero" id="top">
    <div class="container hero-grid">
      <div>
        {h.eyebrow && <div class="eyebrow">{h.eyebrow}</div>}
        {h.hero_heading && <h1>{h.hero_heading}</h1>}
        {h.hero_lead && <p class="lead">{h.hero_lead}</p>}
        {h.hero_note && <p class="muted hero-note">{h.hero_note}</p>}
        <div class="actions">
          {h.cta_primary_label && (
            <a class="btn btn-primary" href={h.cta_primary_url}>{h.cta_primary_label}</a>
          )}
          {h.cta_secondary_label && (
            <a class="btn btn-secondary" href={h.cta_secondary_url}>{h.cta_secondary_label}</a>
          )}
        </div>
      </div>

      <ImageSlot
        src={h.hero_image}
        alt={h.hero_image_alt}
        placeholder={h.hero_image_placeholder}
        class="is-hero"
      />
    </div>
  </section>

  {upcoming.length > 0 && (
    <section id="upcoming-events" aria-labelledby="upcoming-events-heading">
      <div class="container">
        <div class="page-intro">
          <h2 id="upcoming-events-heading">{h.events_heading}</h2>
          {h.events_intro && <p>{h.events_intro}</p>}
        </div>
        <div class="home-event-grid">
          {upcoming.map((ev) => (
            <article class="card home-event-card">
              {ev.image && (
                <img class="home-event-image" src={ev.image} alt={ev.image_alt || ev.name} loading="lazy" />
              )}
              <p class="mini event-date"><time datetime={ev.date}>{ev.display_date || ev.date}</time></p>
              <h3>{ev.name}</h3>
              {ev.time && <p class="muted home-event-time">{ev.time}</p>}
              <p class="muted home-event-summary">{ev.summary}</p>
              <a class="btn btn-secondary" href={`/events#${ev.id}`}>
                {h.events_link_label}<span class="sr-only">: {ev.name}</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Different starting points ── -->
  {h.audiences && h.audiences.length > 0 && (
    <section id="who">
      <div class="container">
        {h.audience_heading && (
          <div class="page-intro is-wide"><h2>{h.audience_heading}</h2></div>
        )}
        <div class="audience-grid">
          {h.audiences.map((a) => (
            <article class="audience-item">
              <ImageSlot src={a.image} alt={a.image_alt} placeholder={a.label} />
              <p>{a.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── What makes Connected different ── -->
  {h.features && h.features.length > 0 && (
    <section id="difference">
      <div class="container">
        <div class="page-intro">
          {h.features_heading && <h2>{h.features_heading}</h2>}
          {h.features_intro && <p>{h.features_intro}</p>}
        </div>
        <div class="feature-grid">
          {h.features.map((f) => (
            <article class="feature">
              <h3>{f.heading}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── The Connected Experience ── -->
  {phases.length > 0 && (
    <section id="experience">
      <div class="container">
        <div class="page-intro">
          {h.phases_heading && <h2>{h.phases_heading}</h2>}
          {h.phases_intro && <p>{h.phases_intro}</p>}
        </div>
        <div class="story-flow">
          {phases.map((p) => (
            <article class="story">
              <div class="story-copy">
                <p class="step-num">{p.num}</p>
                <h3>{p.heading}</h3>
                <p>{p.body}</p>
              </div>
              <div class="story-media">
                <ImageSlot src={p.image} alt={p.image_alt} placeholder={p.image_placeholder} />
              </div>
            </article>
          ))}
        </div>
        {h.actions && (
          <div class="actions">
            {h.actions.map((a) => (
              <a class={`btn btn-${a.style ?? 'secondary'}`} href={a.url}>{a.label}</a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {h.founder_intro_heading && (
    <section id="meet-founders" aria-labelledby="founder-intro-heading">
      <div class="container">
        <div class="page-intro is-wide">
          <h2 id="founder-intro-heading">{h.founder_intro_heading}</h2>
          {h.founder_intro_paragraphs?.map(paragraph => <p>{paragraph}</p>)}
          {h.founder_intro_link_label && <a class="btn btn-secondary" href={h.founder_intro_link_url}>{h.founder_intro_link_label}</a>}
        </div>
        {h.founder_intro_image && (
          <figure class="founder-intro-photo">
            <a href={h.founder_intro_link_url}><img src={h.founder_intro_image} alt={h.founder_intro_image_alt} loading="lazy" style="display:block;width:100%;height:auto;" /></a>
            {h.founder_intro_image_caption && <figcaption style="margin-top:var(--space-3);"><a href={h.founder_intro_link_url}>{h.founder_intro_image_caption}</a></figcaption>}
          </figure>
        )}
        {h.founder_intro_video_url && <video controls preload="metadata" class="founder-intro-video" src={h.founder_intro_video_url} poster={h.founder_intro_image} />}
      </div>
    </section>
  )}

  <!-- ── Closing CTA ── -->
  {h.cta_heading && (
    <section id="join">
      <div class="container">
        <div class="cta-band">
          <h2>{h.cta_heading}</h2>
          {h.cta_body && <p>{h.cta_body}</p>}
          {h.cta_label && (
            <div class="actions">
              <a class="btn btn-primary" href={h.cta_url}>{h.cta_label}</a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

</Base>
