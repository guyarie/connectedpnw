---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const contact = await getEntry('site', 'contact');
const c = contact.data;
---

<Base title={`${c.title} — Connected PNW`} description={c.description}>

  <div class="page-hero">
    <div class="container">
      <div class="page-intro" style="margin-bottom:0;">
        {c.kicker && <p class="kicker">{c.kicker}</p>}
        {c.section_heading && <h1>{c.section_heading}</h1>}
        <h2>{c.title}</h2>
        {c.section_intro && <p class="lead" style="margin-bottom:0;">{c.section_intro}</p>}
      </div>
    </div>
  </div>

  <section>
    <div class="container" style="max-width:640px;">
      {c.contact_program_details && <p>{c.contact_program_details}</p>}
      {c.contact_commitment && <p><strong>{c.contact_commitment}</strong></p>}
      <div class="panel">
        <form
          id="contact-form"
          method="POST"
          action={c.contact_form_action ?? '#'}
          data-mailerlite={c.mailerlite_form_action ?? ''}
          data-redirect={c.contact_redirect_url}
          data-sending={c.contact_sending_label}
          data-error={c.contact_error_message}
        >
          <input type="hidden" name="_subject" value={c.contact_subject} />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <div style="display:grid;gap:var(--space-5);">

            <div class="form-grid">
              <div class="form-field">
                <label for="first_name">First name</label>
                <input type="text" id="first_name" name="first_name" autocomplete="given-name" required />
              </div>
              <div class="form-field">
                <label for="last_name">Last name</label>
                <input type="text" id="last_name" name="last_name" autocomplete="family-name" required />
              </div>
            </div>

            <div class="form-field">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>

            <div class="form-field">
              <label for="phone">Phone number</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" required />
            </div>

            <div class="form-field">
              <label for="instagram">Instagram handle <span class="muted">(optional)</span></label>
              <input
                type="text"
                id="instagram"
                name="instagram"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                placeholder="@yourhandle"
              />
            </div>

            <div class="form-field">
              <label for="hear_about">How did you hear about Connected PNW?</label>
              <select id="hear_about" name="hear_about">
                <option value="">Select one…</option>
                <option value="friend">Friend or colleague</option>
                <option value="therapist">Therapist or coach</option>
                <option value="social">Social media</option>
                <option value="search">Web search</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-field">
              <label for="message">Anything you'd like us to know? <span class="muted">(optional)</span></label>
              <textarea id="message" name="message"></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%;">
              {c.contact_button_label}
            </button>

          </div>
        </form>
      </div>

      {c.contact_note && (
        <p class="muted" style="font-size:var(--text-sm);margin-top:var(--space-5);text-align:center;">
          {c.contact_note}
        </p>
      )}
    </div>
  </section>

</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (btn.disabled) return;
    const buttonLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = form.dataset.sending ?? buttonLabel;

    const data = new FormData(form);

    // Dual submit: Formspree emails the founders the full submission (incl. the
    // message); MailerLite adds the subscriber to the interest list group so the
    // nurture sequence starts. The message field is deliberately NOT sent to
    // MailerLite — it may contain personal detail that belongs in the founders'
    // inbox, not in an ESP profile.
    const submits: Promise<Response>[] = [
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      }),
    ];

    const mlAction = form.dataset.mailerlite;
    const honeypotTripped = !!data.get('_gotcha');
    if (mlAction && !honeypotTripped) {
      const mlBody = new URLSearchParams();
      mlBody.set('fields[email]', String(data.get('email') ?? ''));
      mlBody.set('fields[name]', String(data.get('first_name') ?? ''));
      mlBody.set('fields[last_name]', String(data.get('last_name') ?? ''));
      mlBody.set('fields[phone]', String(data.get('phone') ?? ''));
      mlBody.set('fields[hear_about]', String(data.get('hear_about') ?? ''));

      // Normalised without the leading @ so the value is consistent in
      // MailerLite regardless of how people type it.
      const instagram = String(data.get('instagram') ?? '').trim().replace(/^@+/, '');
      if (instagram) mlBody.set('fields[instagram]', instagram);
      mlBody.set('ml-submit', '1');
      mlBody.set('anticsrf', 'true');
      submits.push(fetch(mlAction, { method: 'POST', body: mlBody }));
    }

    const results = await Promise.allSettled(submits);
    // Formspree must receive the full submission before scheduling proceeds.
    const primaryResult = results[0];
    const formDelivered = primaryResult.status === 'fulfilled' && primaryResult.value.ok;
    if (formDelivered && form.dataset.redirect) {
      window.location.href = form.dataset.redirect;
    } else {
      btn.disabled = false;
      btn.textContent = buttonLabel;
      alert(form.dataset.error);
    }
  });
</script>
