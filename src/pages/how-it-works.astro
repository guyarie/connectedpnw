---
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { getEntry } from 'astro:content';

const how = await getEntry('site', 'how');
const w = how.data;
const phases = w.phases ?? [];
---

<Base title={`${w.title} — Connected PNW`} description={w.description}>

  <div class="page-hero">
    <div class="container">
      <div class="page-intro" style="margin-bottom:0;">
        {w.kicker && <p class="kicker">{w.kicker}</p>}
        {w.section_heading && <h1>{w.section_heading}</h1>}
        {w.section_intro && <p class="lead" style="margin-bottom:0;">{w.section_intro}</p>}
      </div>
    </div>
  </div>

  {w.timeline_steps?.length > 0 && (
    <section aria-labelledby="program-timeline-heading">
      <div class="container">
        <h2 id="program-timeline-heading" class="sr-only">{w.timeline_heading}</h2>
        {w.timeline_image && <img src={w.timeline_image} alt="" loading="lazy" class="program-timeline-image" />}
        <ol class="sr-only">
          {w.timeline_steps.map(step => <li><h3>{step.heading}</h3><p>{step.body}</p></li>)}
        </ol>
      </div>
    </section>
  )}

  <section>
    <div class="container">
      <div class="phase-flow">
        {phases.map((p) => (
          <article class="phase">
            <div class="phase-copy">
              <p class="step-num">{p.num}</p>
              <h2>{p.heading}</h2>
              {(p.detail ?? [p.body]).map((para) => <p>{para}</p>)}

              {p.list && p.list.length > 0 && (
                <>
                  {p.list_heading && <h3>{p.list_heading}</h3>}
                  <ul class="phase-list">
                    {p.list.map((item) => <li>{item}</li>)}
                  </ul>
                </>
              )}

              {p.num !== "02" && p.list_footnote && p.list_footnote.trim().split(/\n\s*\n/).map((paragraph, index, paragraphs) => (paragraphs.length > 1 && index === 0 ? <h3 style="margin-top:var(--space-5);">{paragraph}</h3> : <p style={index === 0 ? "margin-top:var(--space-5);" : undefined}>{paragraph}</p>))}
            </div>
            <div class="phase-media">
              <ImageSlot src={p.image} alt={p.image_alt} placeholder={p.image_placeholder} />
              {p.num === "02" && p.list_footnote && (
                <aside class="practice-week-box">
                  {p.list_footnote.trim().split(/\n\s*\n/).map((paragraph, index) => index === 0 ? <h3>{paragraph}</h3> : <p>{paragraph}</p>)}
                </aside>
              )}
            </div>
          </article>
        ))}
      </div>

      {w.actions && (
        <div class="actions" style="margin-top:clamp(3rem,6vw,4.5rem);">
          {w.actions.map((a) => (
            <a class={`btn btn-${a.style ?? 'secondary'}`} href={a.url}>{a.label}</a>
          ))}
        </div>
      )}
    </div>
  </section>

</Base>
